# A100 (Ampere sm_80, 40 GB, IN2) — non-secret profile, merged into .env by the workflow.
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
# L4 KV pool size, used only when EMULATE_L4=true (from check B2 on L4).
KV_CACHE_MEMORY_BYTES=4G
FP8_MODE=w8a16
KV_CACHE_DTYPE_FP8_SUPPORTED=false
VLLM_ENABLE_CUDA_COMPATIBILITY=0
