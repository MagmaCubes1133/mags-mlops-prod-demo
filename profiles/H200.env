# H200 (Hopper sm_90, 141 GB, IN2) — non-secret profile, merged into .env by the workflow.
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
# L4 KV pool: 70,656 tokens x 57,344 B = 3.77 GiB (check B2, util 0.90). Used only when EMULATE_L4=true.
KV_CACHE_MEMORY_BYTES=4051697664
FP8_MODE=w8a8
KV_CACHE_DTYPE_FP8_SUPPORTED=true
VLLM_ENABLE_CUDA_COMPATIBILITY=0
