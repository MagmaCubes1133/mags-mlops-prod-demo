# Copy to .env (never commit .env). The workflow builds .env from profiles/<gpu>.env + secrets.
# Keep comments on their own lines: compose does not strip "# ..." after an empty value.

# --- secrets ---
# Bearer token clients send to Caddy; also vLLM --api-key
GATEWAY_KEY=change-me-long-random
# Optional: all pinned repos are public
HF_TOKEN=

# --- pins (never float) ---
MODEL_REVISION=a09a35458c702b33eeacc393d103063234e8bc28
AWQ_REVISION=b25037543e9394b818fdfca67ab2a00ecc7dd641
VLLM_IMAGE=vllm/vllm-openai:v0.34.0@sha256:20fdb089454afbb324efa4110a2c025ff7b27cc1a086e07aa580b18df8ad1ce1
CADDY_IMAGE=caddy:2.11.9@sha256:4851e54a46b206517c574821bb5cc67f170d2156041e9fbc4c9193b45e84a75b

# --- per-GPU knobs (see profiles/*.env) ---
MAX_MODEL_LEN=8192
# vLLM default is 1.0 (extensible KV cache); 0.90 for teaching
GPU_MEMORY_UTILIZATION=0.90
# e.g. 4G: pins the KV pool (the workflow adds it via VLLM_EXTRA_ARGS when EMULATE_L4=true)
KV_CACHE_MEMORY_BYTES=
# w8a8 on Ada/Hopper/Blackwell; w8a16 (Marlin) on Ampere. Informational: the flag is the same.
FP8_MODE=w8a8
# false on Ampere: skip --kv-cache-dtype fp8
KV_CACHE_DTYPE_FP8_SUPPORTED=true
# 1 if the host driver is older than R580
VLLM_ENABLE_CUDA_COMPATIBILITY=0
# Appended to `vllm serve`, e.g. --kv-cache-dtype fp8
VLLM_EXTRA_ARGS=

# --- edge ---
# :80 = plain HTTP on the VM IP. Host name(s) here (DNS -> this host, ports 80+443 open) get automatic HTTPS, e.g.
# SITE_ADDRESS="1-2-3-4.sslip.io http://localhost http://127.0.0.1"  (the Actions deploy writes this for you)
SITE_ADDRESS=:80
PUBLIC_PORT=80
PUBLIC_TLS_PORT=443
